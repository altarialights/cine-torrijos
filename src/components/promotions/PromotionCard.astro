---
import type { promotions } from "../../data/cinema";

type Promotion = (typeof promotions)[number];

interface Props {
  promotion: Promotion;
  index: number;
}

const { promotion, index } = Astro.props;
---

<article
  class:list={[
    "promotion-card",
    `promotion-card--${promotion.id}`,
    promotion.featured && "promotion-card--featured",
    "reveal-item",
  ]}
  style={`--reveal-index: ${index}`}
>
  <div class="promotion-card__media" aria-hidden="true">
    <img src={promotion.image} alt="" width="720" height="720" loading="lazy" decoding="async" />
  </div>
  <div class="promotion-card__content">
    {promotion.label && <p class="promotion-card__label">{promotion.label}</p>}
    <h3>{promotion.title}</h3>
    <p>{promotion.description}</p>
    {promotion.detail && <span>{promotion.detail}</span>}
    {
      promotion.cta && (
        <button type="button" data-promo-button={promotion.id} aria-expanded="false">
          {promotion.cta}
        </button>
      )
    }
    <small data-promo-panel={promotion.id} hidden>
      Contenido informativo de demo. El propietario podrá sustituir aquí condiciones y detalles reales.
    </small>
  </div>
</article>

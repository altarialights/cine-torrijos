---
import type { promotions } from "../../data/cinema";

type Promotion = (typeof promotions)[number];

interface Props {
  promotion: Promotion;
  index: number;
}

const { promotion, index } = Astro.props;
const eyebrow = promotion.featured ? "La experiencia completa" : promotion.label;
const ctaHref =
  promotion.id === "menu-torrijos" ? "/#comida" : promotion.id === "dia-del-espectador" ? "/#contacto" : undefined;
---

<article
  class:list={[
    "promotion-card",
    `promotion-card--${promotion.id}`,
    promotion.featured && "promotion-card--featured",
    "reveal-item",
  ]}
  style={`--reveal-index: ${index}`}
>
  <div class="promotion-card__media" aria-hidden="true">
    <img src={promotion.image} alt="" width="1472" height="1024" loading="lazy" decoding="async" />
  </div>

  <div class="promotion-card__content">
    {eyebrow && <p class="promotion-card__label">{eyebrow}</p>}
    <h3>{promotion.title}</h3>
    <p>{promotion.description}</p>
    {promotion.detail && <span>{promotion.detail}</span>}

    {
      promotion.cta && ctaHref && (
        <a class="promotion-card__button" href={ctaHref}>
          <span>{promotion.cta}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="M8.75 5.75 15 12l-6.25 6.25" />
          </svg>
        </a>
      )
    }
  </div>
</article>

---
import { navItems } from "../../data/cinema";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="section-inner site-footer__inner">
    <div>
      <a class="site-footer__brand" href="/#inicio">Cine Torrijos</a>
      <p>Donde el cine cobra vida.</p>
    </div>
    <nav aria-label="Navegación secundaria">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <p class="site-footer__legal">© {year} Cine Torrijos. Todos los derechos reservados.</p>
  </div>
</footer>

---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import ExperienceCarousel from "../components/sections/ExperienceCarousel.astro";
import Footer from "../components/sections/Footer.astro";
import FoodSection from "../components/sections/FoodSection.astro";
import HistorySection from "../components/sections/HistorySection.astro";
import LocationSection from "../components/sections/LocationSection.astro";
import MoviesSection from "../components/sections/MoviesSection.astro";
import PromotionsSection from "../components/sections/PromotionsSection.astro";
import ScheduleSection from "../components/sections/ScheduleSection.astro";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Cine Torrijos: una experiencia cinematografica local, moderna e inmersiva."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Cine Torrijos</title>
  </head>
  <body>
    <!--
    THESIS: Cine Torrijos opens as a real local cinema scene, refusing a generic landing-page shell.
    OWN-WORLD: Carbon black, red curtain action, warm gold details, rectangular controls, and authored line icons.
    STORY: Visitors identify the cinema, feel the room, and move toward cartelera or ticket purchase.
    FIRST VIEWPORT: Full-bleed auditorium image, left editorial title, top overlay header, primary action below copy.
    FORM: Brief-pinned cinematic cover direction; seed key: user-locked-cine-torrijos-header-hero.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <Header />
    <main>
      <Hero />
      <HistorySection />
      <MoviesSection />
      <ScheduleSection />
      <PromotionsSection />
      <FoodSection />
      <ExperienceCarousel />
      <LocationSection />
      <ContactSection />
    </main>
    <Footer />
    <script>
      const revealItems = document.querySelectorAll(".reveal-item");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduceMotion) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
        );

        revealItems.forEach((item) => revealObserver.observe(item));
      }
    </script>
  </body>
</html>
